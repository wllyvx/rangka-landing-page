  <script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const items = document.querySelectorAll(".reveal");
    if (reduce || !("IntersectionObserver" in window)) {
      items.forEach((el) => el.classList.add("is-in"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      items.forEach((el) => io.observe(el));
    }

    const wrap = document.getElementById("spine-wrap");
    const fill = document.getElementById("spine-fill");
    const setSpine = () => {
      if (!wrap || !fill) return;
      if (reduce) {
        fill.style.transform = "scaleY(1)";
        return;
      }
      const r = wrap.getBoundingClientRect();
      const vh = window.innerHeight || 800;
      const total = r.height - vh * 0.4;
      const done = Math.min(1, Math.max(0, (vh * 0.7 - r.top) / Math.max(1, total)));
      fill.style.transform = `scaleY(${done.toFixed(3)})`;
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        setSpine();
        ticking = false;
      });
    };
    setSpine();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);

    const copyBtn = document.getElementById("salin-template");
    const copyStatus = document.getElementById("salin-status");
    const templateEl = document.getElementById("template-chat");
    const contohKebutuhan = {
      "Desain konsep hunian": "[mis. denah + suasana ruang tamu 3×4 m]",
      "Gambar kerja + pendampingan": "[mis. ukuran + titik listrik dapur 2×3 m]",
      "Penataan ulang tanpa bongkar": "[mis. zonasi ruang tamu + penyimpanan]",
      "Kurasi material & furnitur": "[mis. kayu terang + kain natural kamar tidur]",
    };
    const templateUntuk = (layanan) => {
      const kebutuhan = contohKebutuhan[layanan] || "[ceritakan kebutuhan]";
      return `Halo Rangka, saya ingin konsultasi ${layanan}. Hunian saya [rumah/apartemen, ±__ m², __ ruang]. Kebutuhan: ${kebutuhan} Bisa info jadwal + rentang biaya awal? Terima kasih.`;
    };
    let resetTimer = 0;
    const setStatus = (msg) => {
      if (copyStatus) copyStatus.textContent = msg;
    };
    const setLabel = (msg) => {
      const label = copyBtn ? copyBtn.querySelector("[data-copy-label]") : null;
      if (label) label.textContent = msg;
    };
    const fallbackCopy = (text) => {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      ta.remove();
      return ok;
    };
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const targetId = copyBtn.getAttribute("data-copy-target");
        const source = targetId ? document.getElementById(targetId) : null;
        const text = (source ? source.textContent : "").trim();
        if (!text) {
          setStatus("Template kosong — muat ulang halaman lalu coba lagi.");
          return;
        }
        copyBtn.disabled = true;
        window.clearTimeout(resetTimer);
        let ok = false;
        try {
          if (navigator.clipboard && window.isSecureContext !== false) {
            await navigator.clipboard.writeText(text);
            ok = true;
          } else {
            ok = fallbackCopy(text);
          }
        } catch {
          ok = fallbackCopy(text);
        }
        if (ok) {
          setLabel("Tersalin!");
          setStatus("Tersalin — tempel di aplikasi chat pilihan Anda.");
        } else {
          setLabel("Salin template chat");
          setStatus("Gagal menyalin otomatis — blok teks di atas lalu salin manual.");
        }
        resetTimer = window.setTimeout(() => {
          copyBtn.disabled = false;
          if (ok) setLabel("Salin template chat");
        }, 1200);
      });
    }

    const cakupanInputs = document.querySelectorAll('input[name="cakupan"]');
    const pilihCakupan = (layanan, umumkan = true) => {
      if (!layanan || !templateEl) return;
      cakupanInputs.forEach((input) => {
        if (input.value === layanan) input.checked = true;
      });
      templateEl.textContent = templateUntuk(layanan);
      if (umumkan) setStatus(`Dipilih: ${layanan} — template sudah terisi, tinggal salin.`);
    };
    cakupanInputs.forEach((input) => {
      input.addEventListener("change", () => {
        if (input.checked) pilihCakupan(input.value, true);
      });
    });
    document.querySelectorAll("a[data-layanan]").forEach((link) => {
      link.addEventListener("click", () => {
        const layanan = link.getAttribute("data-layanan");
        if (layanan) pilihCakupan(layanan, true);
      });
    });
  </script>
