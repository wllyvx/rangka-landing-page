                aria-describedby="salin-status"
                class="mt-4 inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-paper px-6 py-3.5 text-[15px] font-semibold text-ink transition-colors duration-200 hover:bg-gold-soft disabled:cursor-not-allowed disabled:opacity-70"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <rect x="5" y="5" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.8" />
                  <path d="M11 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <span data-copy-label>Salin template chat</span>
              </button>
              <p id="salin-status" role="status" aria-live="polite" class="tnum mt-2 min-h-5 text-[13px] leading-5 text-night-faint"></p>
              <div class="mt-3 rounded-xl border border-night-line p-4">
                <p class="text-[13px] font-semibold text-paper">Setelah salin, apa yang terjadi?</p>
                <p class="mt-1 text-[13px] leading-5 text-night-faint">Tempel di aplikasi chat — Anda dapat 3 pertanyaan lanjutan, lalu jadwal + rentang biaya tertulis. Tanpa komitmen.</p>
              </div>
              <p class="tnum mt-4 text-[13px] leading-5 text-night-faint">Respons contoh: hari kerja · 09.00–17.00</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p class="flex items-center gap-2.5">
        <svg width="24" height="24" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <rect x="1.5" y="1.5" width="27" height="27" rx="7" stroke="#1c1917" stroke-width="2" />
          <path d="M9 20V10h5.2c2.1 0 3.6 1.2 3.6 3 0 1.3-.8 2.3-2 2.7L18.5 20h-2.6l-2.4-4H11v4H9Zm2-5.6h3c1 0 1.7-.6 1.7-1.4 0-.9-.7-1.4-1.7-1.4h-3v2.8Z" fill="#1c1917" />
          <circle cx="21" cy="21" r="2.6" fill="#92400e" />
        </svg>
        <span class="font-display text-base font-semibold">Rangka</span>
        <span class="text-sm text-muted-ink">— studio fiktif, contoh portofolio.</span>
      </p>
      <nav class="flex flex-wrap gap-1 text-sm font-medium" aria-label="Navigasi footer">
        <a href="#layanan" class="min-h-11 rounded-lg px-3 py-2.5 text-ink-soft hover:text-ink">Layanan</a>
        <a href="#gaya" class="min-h-11 rounded-lg px-3 py-2.5 text-ink-soft hover:text-ink">Gaya</a>
        <a href="#proses" class="min-h-11 rounded-lg px-3 py-2.5 text-ink-soft hover:text-ink">Proses</a>
        <a href="#kontak" class="min-h-11 rounded-lg px-3 py-2.5 text-ink-soft hover:text-ink">Kontak</a>
      </nav>
      <p class="tnum text-[13px] text-muted-ink">© 2026 · Tanpa klaim klien, penghargaan, atau statistik.</p>
    </div>
  </footer>

  <script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const items = document.querySelectorAll(".reveal");
    if (reduce || !("IntersectionObserver" in window)) {
      items.forEach((el) => el.classList.add("is-in"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      items.forEach((el) => io.observe(el));
    }

    const wrap = document.getElementById("spine-wrap");
    const fill = document.getElementById("spine-fill");
    const setSpine = () => {
      if (!wrap || !fill) return;
      if (reduce) {
        fill.style.transform = "scaleY(1)";
        return;
      }
      const r = wrap.getBoundingClientRect();
      const vh = window.innerHeight || 800;
      const total = r.height - vh * 0.4;
      const done = Math.min(1, Math.max(0, (vh * 0.7 - r.top) / Math.max(1, total)));
      fill.style.transform = `scaleY(${done.toFixed(3)})`;
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        setSpine();
        ticking = false;
      });
    };
    setSpine();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);

    const navMenu = document.getElementById("nav-menu");
    const navToggle = document.getElementById("nav-toggle");
    const navLabel = navMenu ? navMenu.querySelector("[data-nav-label]") : null;
    const syncNav = () => {
      const open = navMenu ? navMenu.open : false;
      if (navToggle) navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      if (navLabel) navLabel.textContent = open ? "Tutup navigasi" : "Buka navigasi";
    };
    if (navMenu && navToggle) {
      navToggle.addEventListener("click", () => requestAnimationFrame(syncNav));
      navMenu.addEventListener("toggle", syncNav);
      navMenu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
        navMenu.open = false;
        syncNav();
      }));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && navMenu.open) {
          navMenu.open = false;
          syncNav();
          navToggle.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (navMenu.open && e.target instanceof Node && !navMenu.contains(e.target)) {
          navMenu.open = false;
          syncNav();
        }
      });
      syncNav();
    }

    const copyBtn = document.getElementById("salin-template");
    const copyStatus = document.getElementById("salin-status");
    const templateEl = document.getElementById("template-chat");
    const contohKebutuhan = {
      "Desain konsep hunian": "[mis. denah + suasana ruang tamu 3×4 m]",
      "Gambar kerja + pendampingan": "[mis. ukuran + titik listrik dapur 2×3 m]",
      "Penataan ulang tanpa bongkar": "[mis. zonasi ruang tamu + penyimpanan]",
      "Kurasi material & furnitur": "[mis. kayu terang + kain natural kamar tidur]",
    };
    const templateUntuk = (layanan) => {
      const kebutuhan = contohKebutuhan[layanan] || "[ceritakan kebutuhan]";
      return `Halo Rangka, saya ingin konsultasi ${layanan}. Hunian saya [rumah/apartemen, ±__ m², __ ruang]. Kebutuhan: ${kebutuhan} Bisa info jadwal + rentang biaya awal? Terima kasih.`;
    };
    let resetTimer = 0;
    const setStatus = (msg) => {
      if (copyStatus) copyStatus.textContent = msg;
    };
    const setLabel = (msg) => {
      const label = copyBtn ? copyBtn.querySelector("[data-copy-label]") : null;
      if (label) label.textContent = msg;
    };
    const fallbackCopy = (text) => {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      ta.remove();
      return ok;
    };
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const targetId = copyBtn.getAttribute("data-copy-target");
        const source = targetId ? document.getElementById(targetId) : null;
        const text = (source ? source.textContent : "").trim();
        if (!text) {
          setStatus("Template kosong — muat ulang halaman lalu coba lagi.");
          return;
        }
        copyBtn.disabled = true;
        window.clearTimeout(resetTimer);
        let ok = false;
        try {
          if (navigator.clipboard && window.isSecureContext !== false) {
            await navigator.clipboard.writeText(text);
            ok = true;
          } else {
            ok = fallbackCopy(text);
          }
        } catch {
          ok = fallbackCopy(text);
        }
        if (ok) {
          setLabel("Tersalin!");
          setStatus("Tersalin — tempel di aplikasi chat pilihan Anda.");
        } else {
          setLabel("Salin template chat");
          setStatus("Gagal menyalin otomatis — blok teks di atas lalu salin manual.");
        }
        resetTimer = window.setTimeout(() => {
          copyBtn.disabled = false;
          if (ok) setLabel("Salin template chat");
        }, 1200);
      });
    }

    const cakupanInputs = document.querySelectorAll('input[name="cakupan"]');
    const pilihCakupan = (layanan, umumkan = true) => {
      if (!layanan || !templateEl) return;
      cakupanInputs.forEach((input) => {
        if (input.value === layanan) input.checked = true;
      });
      templateEl.textContent = templateUntuk(layanan);
      try {
        sessionStorage.setItem("rangka-cakupan", layanan);
      } catch {
        /* abaikan */
      }
      if (umumkan) setStatus(`Dipilih: ${layanan} — template sudah terisi, tinggal salin.`);
    };
    try {
      const tersimpan = sessionStorage.getItem("rangka-cakupan");
      if (tersimpan) pilihCakupan(tersimpan, false);
    } catch {
      /* abaikan */
    }
    cakupanInputs.forEach((input) => {
      input.addEventListener("change", () => {
        if (input.checked) pilihCakupan(input.value, true);
      });
    });
    document.querySelectorAll("a[data-layanan]").forEach((link) => {
      link.addEventListener("click", () => {
        const layanan = link.getAttribute("data-layanan");
        if (layanan) pilihCakupan(layanan, true);
      });
    });
  </script>
</Layout>
