---
import Layout from "../layouts/Layout.astro";
import Header from "../components/landing/Header.astro";
import Hero from "../components/landing/Hero.astro";
import Layanan from "../components/landing/Layanan.astro";
import Gaya from "../components/landing/Gaya.astro";
import Proses from "../components/landing/Proses.astro";
import SituasiContoh from "../components/landing/SituasiContoh.astro";
import Kontak from "../components/landing/Kontak.astro";
import Footer from "../components/landing/Footer.astro";
import SkripReveal from "../components/landing/SkripReveal.astro";
---

<Layout
  title="Rangka — Studio Interior untuk Hunian"
  description="Rangka adalah studio interior fiktif untuk rumah dan apartemen. Kami membantu menata ruang dari konsep sampai instalasi dengan alur yang jelas."
>
  <Header />

  <main id="konten" tabindex="-1">
    <Hero />
    <Layanan />
    <Gaya />
    <Proses />
    <SituasiContoh />
    <Kontak />
  </main>

  <Footer />
  <SkripReveal />
</Layout>
