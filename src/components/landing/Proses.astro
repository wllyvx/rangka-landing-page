---
---
<section id="proses" aria-labelledby="judul-proses" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-28">
    <div class="max-w-[60ch]">
      <h2 id="judul-proses" class="reveal font-display text-3xl font-semibold tracking-[-0.015em] text-balance sm:text-4xl lg:text-[2.9rem] lg:leading-[1.1]">
        Tiga tahap yang jelas sejak awal.
      </h2>
      <p class="reveal mt-4 max-w-[48ch] text-base leading-7 text-muted-ink sm:text-lg sm:leading-8">
        Anda selalu tahu proyek sedang berada di tahap mana.
      </p>
    </div>

    <div id="spine-wrap" class="relative mt-14 grid grid-cols-[36px_1fr] gap-6 lg:grid-cols-[56px_1fr] lg:gap-10">
      <div class="relative flex justify-center" aria-hidden="true">
        <div class="spine-rail absolute top-2 bottom-2 w-[3px] rounded-full"></div>
        <div id="spine-fill" class="spine-fill absolute top-2 bottom-2 w-[3px] rounded-full"></div>
      </div>
      <ol class="space-y-6">
        <li class="reveal rounded-2xl border border-line bg-paper p-6 shadow-[0_16px_32px_-24px_rgba(28,25,23,0.35)] sm:p-8">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <span class="tnum inline-flex h-11 w-11 items-center justify-center rounded-full bg-clay font-display text-xl font-semibold text-paper">1</span>
            <h3 class="font-display text-xl font-semibold sm:text-2xl">Konsultasi awal</h3>
            <span class="rounded-full border border-line bg-card px-3 py-1 text-[13px] font-medium text-muted-ink">± 60 mnt · foto + ukuran kasar</span>
          </div>
          <p class="mt-3 max-w-[56ch] text-[15px] leading-7 text-muted-ink">Anda bercerita tentang kebiasaan di rumah. Kami menyamakan ukuran, kebutuhan, biaya, dan jadwal.</p>
          <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-sage-wash px-3.5 py-1.5 text-[13px] font-medium text-sage-deep"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8.5 3.2 3L13 4.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Ringkasan dan rentang biaya tertulis</p>
        </li>
        <li class="reveal rounded-2xl border border-line bg-paper p-6 shadow-[0_16px_32px_-24px_rgba(28,25,23,0.35)] sm:p-8" style="--reveal-delay:80ms">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <span class="tnum inline-flex h-11 w-11 items-center justify-center rounded-full bg-gold font-display text-xl font-semibold text-paper">2</span>
            <h3 class="font-display text-xl font-semibold sm:text-2xl">Konsep + gambar kerja</h3>
            <span class="rounded-full border border-line bg-card px-3 py-1 text-[13px] font-medium text-muted-ink">denah · material · 2x revisi</span>
          </div>
          <p class="mt-3 max-w-[56ch] text-[15px] leading-7 text-muted-ink">Konsep diuji di denah berskala. Setiap perubahan tercatat sebelum keputusan ditetapkan.</p>
          <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-sage-wash px-3.5 py-1.5 text-[13px] font-medium text-sage-deep"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8.5 3.2 3L13 4.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Paket gambar dan daftar belanja</p>
        </li>
        <li class="reveal rounded-2xl border border-line bg-paper p-6 shadow-[0_16px_32px_-24px_rgba(28,25,23,0.35)] sm:p-8" style="--reveal-delay:140ms">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <span class="tnum inline-flex h-11 w-11 items-center justify-center rounded-full bg-sage font-display text-xl font-semibold text-paper">3</span>
            <h3 class="font-display text-xl font-semibold sm:text-2xl">Instalasi + serah terima</h3>
            <span class="rounded-full border border-line bg-card px-3 py-1 text-[13px] font-medium text-muted-ink">jadwal pasang · checklist</span>
          </div>
          <p class="mt-3 max-w-[56ch] text-[15px] leading-7 text-muted-ink">Semua dipasang sesuai urutan gambar, lalu kita periksa bersama sampai rapi.</p>
          <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-sage-wash px-3.5 py-1.5 text-[13px] font-medium text-sage-deep"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8.5 3.2 3L13 4.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Ruang siap dihuni dan catatan perawatan</p>
        </li>
      </ol>
    </div>
  </div>
</section>

<script>
  const reduceSpine = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wrap = document.getElementById("spine-wrap");
  const fill = document.getElementById("spine-fill");
  const setSpine = () => {
    if (!wrap || !fill) return;
    if (reduceSpine) {
      fill.style.transform = "scaleY(1)";
      return;
    }
    const r = wrap.getBoundingClientRect();
    const vh = window.innerHeight || 800;
    const total = r.height - vh * 0.4;
    const done = Math.min(1, Math.max(0, (vh * 0.7 - r.top) / Math.max(1, total)));
    fill.style.transform = `scaleY(${done.toFixed(3)})`;
  };
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      setSpine();
      ticking = false;
    });
  };
  setSpine();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
