---
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href="#atas" class="flex min-h-11 items-center gap-2.5 rounded-lg" aria-label="Rangka — ke atas">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="27" height="27" rx="7" stroke="#1c1917" stroke-width="2" />
        <path d="M9 20V10h5.2c2.1 0 3.6 1.2 3.6 3 0 1.3-.8 2.3-2 2.7L18.5 20h-2.6l-2.4-4H11v4H9Zm2-5.6h3c1 0 1.7-.6 1.7-1.4 0-.9-.7-1.4-1.7-1.4h-3v2.8Z" fill="#1c1917" />
        <circle cx="21" cy="21" r="2.6" fill="#92400e" />
      </svg>
      <span class="font-display text-xl font-semibold tracking-tight">Rangka</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Navigasi utama">
      <a href="#layanan" class="min-h-11 rounded-lg px-4 py-2.5 text-[15px] font-medium text-ink-soft transition-colors hover:bg-gold-soft hover:text-ink">Layanan</a>
      <a href="#gaya" class="min-h-11 rounded-lg px-4 py-2.5 text-[15px] font-medium text-ink-soft transition-colors hover:bg-gold-soft hover:text-ink">Gaya</a>
      <a href="#proses" class="min-h-11 rounded-lg px-4 py-2.5 text-[15px] font-medium text-ink-soft transition-colors hover:bg-gold-soft hover:text-ink">Proses</a>
      <a href="#kontak" class="min-h-11 rounded-lg px-4 py-2.5 text-[15px] font-medium text-ink-soft transition-colors hover:bg-gold-soft hover:text-ink">Kontak</a>
    </nav>
    <div class="flex items-center gap-2">
      <details class="relative md:hidden" id="nav-menu">
        <summary id="nav-toggle" class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-lg border border-line px-3 py-2.5 text-[15px] font-semibold text-ink-soft marker:content-none hover:text-ink" aria-expanded="false" aria-controls="nav-list">
          <span class="sr-only" data-nav-label>Buka navigasi</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </summary>
        <div id="nav-list" class="absolute top-full right-0 mt-2 w-52 max-w-[calc(100vw-2rem)] rounded-2xl border border-line bg-paper p-2 shadow-[0_24px_48px_-24px_rgba(28,25,23,0.4)]">
          <a href="#layanan" class="flex min-h-11 items-center rounded-lg px-4 py-2.5 text-[15px] font-medium text-ink-soft hover:bg-gold-soft hover:text-ink">Layanan</a>
          <a href="#gaya" class="flex min-h-11 items-center rounded-lg px-4 py-2.5 text-[15px] font-medium text-ink-soft hover:bg-gold-soft hover:text-ink">Gaya</a>
          <a href="#proses" class="flex min-h-11 items-center rounded-lg px-4 py-2.5 text-[15px] font-medium text-ink-soft hover:bg-gold-soft hover:text-ink">Proses</a>
          <a href="#kontak" class="flex min-h-11 items-center rounded-lg px-4 py-2.5 text-[15px] font-medium text-ink-soft hover:bg-gold-soft hover:text-ink">Kontak</a>
        </div>
      </details>
      <a
        href="#kontak"
        class="inline-flex min-h-11 items-center rounded-full bg-ink px-5 py-2.5 text-[15px] font-semibold text-paper transition-colors duration-200 hover:bg-night-soft"
      >
        Konsultasi
      </a>
    </div>
  </div>
</header>

<script>
  const navMenu = document.getElementById("nav-menu");
  const navToggle = document.getElementById("nav-toggle");
  const navLabel = navMenu ? navMenu.querySelector("[data-nav-label]") : null;
  const syncNav = () => {
    const open = navMenu ? (navMenu as HTMLDetailsElement).open : false;
    if (navToggle) navToggle.setAttribute("aria-expanded", open ? "true" : "false");
    if (navLabel) navLabel.textContent = open ? "Tutup navigasi" : "Buka navigasi";
  };
  if (navMenu && navToggle) {
    navToggle.addEventListener("click", () => requestAnimationFrame(syncNav));
    navMenu.addEventListener("toggle", syncNav);
    navMenu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
      (navMenu as HTMLDetailsElement).open = false;
      syncNav();
    }));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && (navMenu as HTMLDetailsElement).open) {
        (navMenu as HTMLDetailsElement).open = false;
        syncNav();
        (navToggle as HTMLElement).focus();
      }
    });
    document.addEventListener("click", (e) => {
      if ((navMenu as HTMLDetailsElement).open && e.target instanceof Node && !navMenu.contains(e.target)) {
        (navMenu as HTMLDetailsElement).open = false;
        syncNav();
      }
    });
    syncNav();
  }
</script>
